#!/usr/bin/env bash
set -uo pipefail
export LC_ALL=C
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$root/lib/feeds.bash"

usage() {
    cat <<'HELP'
Usage:
  ./trader stock SYMBOL [INTERVAL] [--once]
  ./trader crypto BASE-QUOTE [INTERVAL] [EXCHANGE|auto] [--once]
  ./trader benchmark [BASE-QUOTE] [INTERVAL]

Stock intervals: 1m 5m 15m 1h 1d (default 1d)
Crypto intervals: 1m 5m 15m 1h 1d (default 5m)
Exchanges: coinbase, kraken, bitstamp, auto (default)
Benchmark defaults: BTC-USD, 5m; five requests per exchange
Chart keys: h/l older/newer, +/- zoom, i SMA, v volume, r refresh, q quit
Set NO_COLOR=1 for plain output. Charts refresh every 30 seconds.
HELP
}

die() { printf '%s\n' "$*" >&2; exit 1; }
[[ ${1:-} != --help && ${1:-} != -h && $# != 0 ]] || { usage; exit; }
for dependency in curl jq awk sort tail mktemp; do
    command -v "$dependency" >/dev/null || die "Missing dependency: $dependency"
done
tmp=$(mktemp -d) || exit 1
trap 'rm -rf -- "$tmp"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mode=$1
shift
once=0
if [[ ${*: -1} == --once ]]; then
    once=1
    set -- "${@:1:$#-1}"
fi
case $mode in
    stock) (( $# >= 1 && $# <= 2 )) || die "$(usage)"
        symbol=$1 interval=${2:-1d} exchange=yahoo ;;
    crypto) (( $# >= 1 && $# <= 3 )) || die "$(usage)"
        symbol=$1 interval=${2:-5m} exchange=${3:-auto} ;;
    benchmark) (( $# <= 2 && once == 0 )) || die "$(usage)"
        symbol=${1:-BTC-USD} interval=${2:-5m} ;;
    *) die "$(usage)" ;;
esac
symbol=$(printf '%s' "$symbol" | awk '{print toupper($0)}')
if [[ $mode == stock ]]; then
    [[ $symbol =~ ^[A-Z0-9^][A-Z0-9.^=-]{0,23}$ ]] || die 'Invalid stock symbol.'
else
    [[ $symbol =~ ^[A-Z0-9]{2,12}-[A-Z0-9]{2,12}$ ]] || die 'Use a crypto pair such as BTC-USD.'
fi
case $interval in
    1m) minutes=1 range=1d ;;
    5m) minutes=5 range=5d ;;
    15m) minutes=15 range=5d ;;
    1h) minutes=60 range=1mo ;;
    1d) minutes=1440 range=1y ;;
    *) die 'Unsupported interval. Choose 1m, 5m, 15m, 1h or 1d.' ;;
esac

if [[ $mode == benchmark ]]; then
    benchmark 5 || die 'No exchange returned a usable chart for this pair.'
    printf '%-12s %10s %s\n' EXCHANGE MEDIAN_MS SUCCESS
    awk '{printf "%-12s %10.1f %s/5\n", $3, $1*1000, $4}' "$tmp/ranked"
    for venue in "${venues[@]}"; do
        [[ -s $tmp/$venue ]] || printf '%-12s %10s %s\n' "$venue" '--' '0/5'
    done
    read -r _ _ winner _ < "$tmp/ranked"
    printf '\nFastest eligible exchange from this connection: %s\n' "$winner"
    exit
fi
case $exchange in
    auto)
        printf 'Measuring %s candle latency...\n' "$symbol" >&2
        benchmark 3 || die 'No exchange returned usable candles. Try a supported pair or check your connection.'
        read -r _ _ exchange _ < "$tmp/ranked" ;;
    yahoo|coinbase|kraken|bitstamp)
        [[ $mode == stock || $exchange != yahoo ]] || die 'Yahoo is available in stock mode.' ;;
    *) die 'Choose coinbase, kraken, bitstamp or auto.' ;;
esac

refresh() {
    if fetch "$exchange" "$tmp/current" > "$tmp/latency"; then
        mv "$tmp/current" "$tmp/chart"
        status="Fetched $(date -u '+%H:%M:%S UTC') | REST"
    else
        status="Refresh failed | showing last successful data ($(cat "$tmp/error"))"
        [[ -s $tmp/chart ]]
    fi
}

refresh || die "Unable to fetch $symbol from $exchange: $(cat "$tmp/error")"
[[ -t 0 && -t 1 ]] || once=1
color=0
[[ -t 1 && -z ${NO_COLOR+x} && ${TERM:-dumb} != dumb ]] && color=1
bars=60 offset=0 sma=1 volume=1
last_refresh=$SECONDS
previous_view=
while :; do
    cols=90 rows=32
    if [[ -t 1 ]]; then
        if dimensions=$(stty size 2>/dev/null) && [[ $dimensions =~ ^([1-9][0-9]*)\ ([1-9][0-9]*)$ ]]; then
            rows=${BASH_REMATCH[1]} cols=${BASH_REMATCH[2]}
        fi
    fi
    view=$cols:$rows:$bars:$offset:$sma:$volume:$status
    if [[ $view != "$previous_view" ]]; then
        frame=$(awk -v cols="$cols" -v rows="$rows" -v bars="$bars" -v offset="$offset" \
            -v sma="$sma" -v volume="$volume" -v color="$color" -v symbol="$symbol" \
            -v interval="$interval" -v exchange="$exchange" -v status="$status" \
            -f "$root/lib/chart.awk" "$tmp/chart") || die 'Chart rendering failed.'
        if (( once )); then
            printf '%s\n' "$frame"
            break
        fi
        printf '\033[H\033[2J%s\n' "$frame"
        if (( cols >= 63 )); then
            printf 'h/l History   +/- Zoom   i SMA   v Volume   r Refresh   q Quit'
        else
            printf 'h/l  +/-  i  v  r  q'
        fi
        previous_view=$view
    fi
    key=
    IFS= read -rsn1 -t 1 key || :
    case $key in
        q|Q) break ;;
        h) (( offset < $(wc -l < "$tmp/chart") - 1 )) && ((offset+=1)) ;;
        l) (( offset > 0 )) && ((offset-=1)) ;;
        +|=) (( bars > 10 )) && ((bars-=5)) ;;
        -) (( bars < 300 )) && ((bars+=5)) ;;
        i) ((sma=1-sma)) ;;
        v) ((volume=1-volume)) ;;
    esac
    if [[ $key == r ]] || (( SECONDS - last_refresh >= 30 )); then
        refresh
        previous_view=
        last_refresh=$SECONDS
    fi
done
